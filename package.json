{
  "name": "taskmatrix",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "server",
    "client/src"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client/src",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client/src run dev",
    "build:client": "npm --prefix client/src run build",
    "check:server": "npm --prefix server run build"
  }
}
